<?xml version="1.0" encoding="utf-8"?>
<!-- ConstraintLayout host: fragment area fills the screen, floating pill nav + round add button sit on top -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_md"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/notes_surface"
            app:cardCornerRadius="@dimen/corner_pill"
            app:cardElevation="@dimen/elevation_nav"
            app:strokeWidth="0dp">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="@dimen/nav_height"
                android:background="@android:color/transparent"
                app:elevation="0dp"
                app:labelVisibilityMode="selected"
                app:menu="@menu/bottom_nav_menu" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:contentDescription="@string/cd_add_note"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/notes_accent"
            app:fabCustomSize="@dimen/fab_size"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Notes.Circle"
            app:tint="@color/notes_on_accent" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
